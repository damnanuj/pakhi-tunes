    "react-native-svg": "15.12.1",
    "react-native-track-player": "4.1.2",
    "react-native-web": "^0.21.0",
    "tamagui": "^1.126.13",
    "zustand": "^5.0.6"
  },
  "overrides": {
    "@tamagui/portal": "1.144.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.6",

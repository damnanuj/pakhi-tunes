{
  "name": "pakhi-tunes",
  "main": "./index.js",
  "version": "1.0.0",
  "pyarnrivate": true,
  "scripts": {
    "upgrade:tamagui": "yarn up '*tamagui*'@latest '@tamagui/*'@latest",
    "upgrade:tamagui:canary": "yarn up '*tamagui*'@canary '@tamagui/*'@canary",
    "check:tamagui": "tamagui check",
    "start": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild:clean": "expo prebuild --clean",
    "rebuild:android": "expo prebuild --clean && expo run:android",
    "rebuild:ios": "expo prebuild --clean && expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "postinstall": "patch-package"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated@~4.0.1"
      ]
    }
  },
  "dependencies": {
    "@bottom-tabs/react-navigation": "^1.1.0",
    "@expo-google-fonts/m-plus-rounded-1c": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^15.0.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.6",
    "@tamagui/config": "^1.126.13",
    "@tamagui/lucide-icons": "^1.126.13",
    "@tamagui/portal": "1.144.4",
    "@tanstack/react-query": "^5.83.0",
    "axios": "^1.10.0",
    "babel-preset-expo": "~54.0.10",
    "base-64": "^1.0.0",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.13",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "metro": "^0.83.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-bottom-tabs": "^1.1.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-reanimated": "~3.19.1",

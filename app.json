{
  "expo": {
    "name": "Pakhi Tunes",
    "slug": "pakhi-tunes",
    "owner": "damnanuj",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pakhitunes",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/entry-hero.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.damnanuj.pakhitunes"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.damnanuj.pakhitunes"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true,
            "useFrameworks": "static"
          },
          "android": {
            "newArchEnabled": true
          },
          "node": "20.19.4"
        }
      ],
      "expo-web-browser",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "180ebec4-d962-4318-8b8b-286826c15e36"
      }
    }
  }
}
